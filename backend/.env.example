# Copiar a backend/.env  (el archivo .env NO se versiona)
# Se carga automáticamente al ejecutar `mvn spring-boot:run` desde /backend.

# --- Redis (Upstash) ---
# Upstash Console -> tu base de datos -> "Endpoint"
REDIS_HOST=tu-instancia.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=tu-password-de-upstash
# Upstash requiere TLS. Para Redis local (docker-compose) poner false.
REDIS_SSL=true

# --- Servidor ---
PORT=8080
# Orígenes permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Opcionales (valores por defecto entre paréntesis) ---
# SRI_BASE_URL=https://srienlinea.sri.gob.ec
# SRI_TIMEOUT_MS=8000
# ANT_BASE_URL=https://consultaweb.ant.gob.ec/PortalWEB/paginas/clientes/clp_grid_citaciones.jsp
# ANT_TIMEOUT_MS=5000
# ANT_FRESH_TTL=1h
# ANT_BACKUP_TTL=7d
# ANT_SERVE_FRESH_CACHE=false
