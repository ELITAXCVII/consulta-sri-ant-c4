# Copiar a frontend/.env (no se versiona)

# URL base del backend en producción (sin "/" final). Ejemplo: https://mi-api.onrender.com
# Déjala vacía en desarrollo: Vite redirige /api al backend con el proxy.
VITE_API_BASE_URL=

# Solo desarrollo: destino del proxy de Vite
VITE_DEV_PROXY_TARGET=http://localhost:8080
